* text=auto

# Source/config files should stay LF across platforms.
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.md text eol=lf
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf

# Keep common binary assets untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
